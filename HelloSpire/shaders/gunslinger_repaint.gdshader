// GENERATED by sts2-reskin-pipeline/tools/gen_shaders.py from config/palettes.toml
// (gunslinger.rest_rules). Do not edit — change the palette and re-run
//   uv run tools/package.py gunslinger --install-hellospire
// Applied to the rest-site, shop and energy-counter art (borrowed from the Ironclad).
shader_type canvas_item;

vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void fragment() {
    vec4 tex = texture(TEXTURE, UV);
    vec3 hsv = rgb2hsv(tex.rgb);
    float hd = hsv.x * 360.0;
    if ((hd >= 335.0 || hd < 25.0) && hsv.y >= 0.45 && hsv.z >= 0.55) {
        // rage glow -> blood red
        hsv = vec3(2.0 / 360.0, min(1.0, hsv.y * 1.1), hsv.z);
    } else if ((hd >= 330.0 || hd < 22.0) && hsv.y >= 0.25) {
        // maroon cloth -> near-black
        hsv = vec3(hsv.x, min(1.0, hsv.y * 0.2), min(1.0, hsv.z * 0.28));
    } else if ((hd >= 22.0 && hd < 52.0) && hsv.y >= 0.28) {
        // leather -> saddle brown
        hsv = vec3(26.0 / 360.0, min(1.0, hsv.y * 1.05), min(1.0, hsv.z * 0.85));
    }
    COLOR = vec4(hsv2rgb(hsv), tex.a);
}
